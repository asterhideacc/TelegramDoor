{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegramdoor",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook", "/health"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegramdoor",
      // Deploy to Cloudflare replaces this placeholder with a new database ID.
      // For manual/CLI deployment, create D1 first and replace it with the real ID.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["17 19 * * *"] },
  "observability": { "enabled": false },
}
