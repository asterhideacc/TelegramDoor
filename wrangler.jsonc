{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegramdoor",
  "keep_vars": true,
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook", "/health"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Select a D1 database as DB in the dashboard before connecting Git.
      // Omitting both name and ID lets Wrangler reuse that binding without D1 API access.
      // CLI users can also let Wrangler provision a database on first deploy.
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["17 19 * * *"] },
  "observability": { "enabled": false },
}
