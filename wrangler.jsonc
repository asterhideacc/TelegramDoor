{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegramdoor",
  "keep_vars": true,
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook", "/health"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Create this D1 database in the dashboard before importing your GitHub repo.
      // Wrangler resolves the name, so deployers do not need to copy a database ID.
      "database_name": "telegramdoor",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["17 19 * * *"] },
  "observability": { "enabled": false },
}
